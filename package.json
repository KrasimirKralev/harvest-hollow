{
  "name": "mnkiswan-tree-village",
  "version": "0.1.0",
  "private": true,
  "description": "MNKISWAN Tree Village: a cozy 3D village farm for one or two farmers, with a picnic matching game. Playable in the browser on GitHub Pages.",
  "license": "MIT",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "HH_DEV=1 HH_DATA_DIR=./data-dev node --watch server/index.js",
    "test": "node --test --test-concurrency=4 \"test/**/*.test.js\"",
    "test:e2e": "node tools/e2e-coop.mjs",
    "shot": "node tools/shot.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "axe-core": "4.11.1",
    "esbuild": "^0.25.12",
    "puppeteer-core": "^25.12.0"
  }
}
